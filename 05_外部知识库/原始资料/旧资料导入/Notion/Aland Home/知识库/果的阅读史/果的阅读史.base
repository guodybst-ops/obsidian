# 果的阅读史

filters:
  and:
    - note["base"] == link("果的阅读史.base")
properties:
  file.name:
    displayName: 名字
  类型:
    displayName: 类型
  文本:
    displayName: 文本
  完成情况:
    displayName: 完成情况
  作者:
    displayName: 作者
  网址:
    displayName: 网址
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 类型
      - 文本
      - 完成情况
      - 作者
      - 网址
