page {
  min-height: 100%;
  background: #f6eef0;
  color: #171717;
  font-family: 'PingFang SC', 'Microsoft YaHei', 'Hiragino Sans GB', 'Heiti SC', 'STHeiti', sans-serif;
  line-height: 1.5;
}

button {
  margin: 0;
  padding: 0;
  line-height: normal;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
}

button::after {
  border: 0;
}

input,
textarea {
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
  padding-bottom: calc(104rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6eef0;
}

.top-bar {
  height: 88rpx;
  padding-top: calc(env(safe-area-inset-top) + 72rpx);
  padding-bottom: 10px;
  padding-left: 180rpx;
  padding-right: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #202020;
  color: #fff;
  font-size: 31rpx;
  font-weight: 700;
  box-sizing: content-box;
  line-height: 1.4;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.top-bar-title {
  display: block;
  max-width: 100%;
  transform: translateY(5px);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}
