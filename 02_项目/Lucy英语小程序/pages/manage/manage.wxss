/* ---- shared shell ---- */
.manage-shell {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f6eef0;
}

.manage-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #202020;
}

.manage-top {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: env(safe-area-inset-top);
}

.manage-top-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
}

.manage-nav {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.manage-nav-item {
  flex: 1;
  height: 58rpx;
  border-radius: 29rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #333;
  color: #aaa;
  font-size: 24rpx;
  font-weight: 700;
}

.manage-nav-item.active {
  background: #ff86a0;
  color: #fff;
}

.manage-body {
  flex: 1;
  padding: 20rpx 24rpx calc(120rpx + env(safe-area-inset-bottom));
}

/* ---- lesson card ---- */
.lesson-card {
  padding: 26rpx 24rpx;
  border-radius: 22rpx;
  background: #fff;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
}

.lesson-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.lesson-card-title {
  flex: 1;
  min-width: 0;
  color: #222;
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-card-level {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  background: #fff0f5;
  color: #ff86a0;
  font-size: 22rpx;
  font-weight: 800;
}

.lesson-card-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.lesson-card-meta text {
  color: #999;
  font-size: 22rpx;
}

.lesson-card-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.btn-sm {
  flex: 1;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.btn-sm-edit {
  background: #fff0f5;
  color: #ff86a0;
}

.btn-sm-delete {
  background: #fff0f0;
  color: #e04060;
}

.btn-sm-add {
  margin-top: 10rpx;
  width: 100%;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff86a0;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
}

/* ---- point edit ---- */
.point-edit-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #f7eef0;
}

.point-edit-item .pt-label {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  background: #ff86a0;
  color: #fff;
  font-size: 20rpx;
}

.point-edit-item .pt-text {
  flex: 1;
  min-width: 0;
  color: #333;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.point-edit-item .pt-del {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f0;
  color: #e04060;
  font-size: 24rpx;
  font-weight: 700;
}

/* ---- modal ---- */
.manage-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}

.manage-modal {
  width: 100%;
  max-height: 80vh;
  padding: 34rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.manage-modal-title {
  margin-bottom: 24rpx;
  color: #111;
  font-size: 32rpx;
  font-weight: 900;
  text-align: center;
}

.manage-field {
  margin-bottom: 18rpx;
}

.manage-field-label {
  margin-bottom: 8rpx;
  color: #666;
  font-size: 24rpx;
  font-weight: 700;
}

.manage-field-input,
.manage-field-textarea {
  width: 100%;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f7eef0;
  color: #222;
  font-size: 27rpx;
  box-sizing: border-box;
}

.manage-field-input {
  height: 76rpx;
}

.manage-field-textarea {
  height: 160rpx;
  padding: 18rpx 24rpx;
}

.manage-field-input::placeholder,
.manage-field-textarea::placeholder {
  color: #b6b6b6;
}

.manage-modal-actions {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

/* ---- history stats ---- */
.stat-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-box {
  padding: 26rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-value {
  color: #ff86a0;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
}

.stat-label {
  margin-top: 6rpx;
  color: #999;
  font-size: 22rpx;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 700;
  color: #ff86a0;
}

/* ---- heatmap ---- */
.heatmap-wrap {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
}

.heatmap-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.heatmap-month {
  color: #222;
  font-size: 26rpx;
  font-weight: 900;
}

.heatmap-nav {
  display: flex;
  gap: 8rpx;
}

.heatmap-nav-btn {
  width: 52rpx;
  height: 44rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7eef0;
  color: #ff86a0;
  font-size: 28rpx;
  font-weight: 900;
}

.heatmap-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6rpx;
}

.heat-cell {
  aspect-ratio: 1;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  color: #bbb;
}

.heat-cell.level-empty { background: #f0f0f0; }
.heat-cell.level-0 { background: #f0f0f0; }
.heat-cell.level-1 { background: #ffd0dc; }
.heat-cell.level-2 { background: #ff86a0; }
.heat-cell.level-3 { background: #ff5c85; }
.heat-cell.level-4 { background: #e03060; }
.heat-cell.level-1,
.heat-cell.level-2,
.heat-cell.level-3,
.heat-cell.level-4 { color: #fff; font-weight: 800; }

.heat-legend {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  font-size: 20rpx;
  color: #aaa;
}

.heat-legend span {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  display: inline-block;
}

/* ---- knowledge list ---- */
.know-list-item {
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #fff;
  margin-bottom: 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #333;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.03);
}

/* ---- settings ---- */
.config-section {
  margin-bottom: 28rpx;
}

.config-section-title {
  margin-bottom: 14rpx;
  color: #222;
  font-size: 28rpx;
  font-weight: 900;
}

.config-item {
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #fff;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.config-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.config-item-name {
  color: #333;
  font-size: 27rpx;
  font-weight: 700;
}

.config-item-points {
  color: #ff86a0;
  font-size: 26rpx;
  font-weight: 900;
}

.config-btn-row {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
}

.config-btn {
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

/* ---- ticket ---- */
.ticket-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #202020;
  margin-bottom: 20rpx;
}

.ticket-bar text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.ticket-bar text.ticket-role {
  color: #ff86a0;
}

.ticket-logout {
  width: 88rpx;
  height: 50rpx;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #e04060;
  font-size: 22rpx;
  font-weight: 800;
}
