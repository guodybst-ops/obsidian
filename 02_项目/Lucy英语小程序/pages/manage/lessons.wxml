<view class="manage-shell">
  <view class="manage-header">
    <view class="manage-top" style="height: 88rpx;">
      <view class="manage-top-title">课文管理</view>
    </view>
    <view class="search-row" style="background:#202020;padding:18rpx 24rpx;">
      <picker mode="selector" range="{{levels}}" value="{{levelIndex}}" bindchange="handleLevel">
        <view class="level-pill">{{levels[levelIndex]}} <text class="chevron">▾</text></view>
      </picker>
      <view class="search-box">
        <input value="{{keyword}}" placeholder="搜索课文名" bindinput="handleSearch" />
      </view>
    </view>
  </view>

  <view class="manage-body">
    <block wx:for="{{filteredLessons}}" wx:key="id">
      <view class="lesson-card">
        <view class="lesson-card-header">
          <text class="lesson-card-title">{{item.title}}</text>
          <text class="lesson-card-level">{{item.level}}</text>
        </view>
        <view class="lesson-card-meta">
          <text>{{item.points.length}} 个知识点</text>
          <block wx:for="{{item.tags}}" wx:key="*this">
            <text>#{{item}}</text>
          </block>
        </view>
        <view class="lesson-card-actions">
          <button class="btn-sm btn-sm-edit" data-id="{{item.id}}" bindtap="openEdit">编辑</button>
          <button class="btn-sm btn-sm-delete" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="deleteLesson">删除</button>
        </view>
      </view>
    </block>
    <button class="btn-sm-add" bindtap="openAdd">+ 添加新课文</button>
  </view>

  <view wx:if="{{showModal}}" class="manage-modal-mask" catchtap="closeModal">
    <view class="manage-modal" catchtap="noop">
      <view class="manage-modal-title">{{editMode ? '编辑课文' : '添加新课文'}}</view>

      <view class="manage-field">
        <view class="manage-field-label">课文名</view>
        <input class="manage-field-input" value="{{editTitle}}" placeholder="输入课文名" bindinput="handleEditTitle" />
      </view>

      <view class="manage-field">
        <view class="manage-field-label">级别</view>
        <picker mode="selector" range="{{levels}}" value="{{editLevelIndex}}" bindchange="handleEditLevel">
          <view class="manage-field-input" style="display:flex;align-items:center;">{{editLevel}} ▾</view>
        </picker>
      </view>

      <view class="manage-field">
        <view class="manage-field-label">知识点列表</view>
        <block wx:for="{{editPointsList}}" wx:key="id">
          <view class="point-edit-item">
            <text class="pt-label">{{item.type}}</text>
            <text class="pt-text">{{item.text}}</text>
            <view class="pt-del" data-idx="{{index}}" catchtap="removePoint">×</view>
          </view>
        </block>
        <view class="manage-field" style="margin-top:14rpx;">
          <textarea class="manage-field-textarea" value="{{pointsText}}" placeholder="输入新知识点，可用换行、逗号分隔" bindinput="handlePointsText" style="height:120rpx;" />
        </view>
        <button class="btn-sm btn-sm-edit" style="margin-top:8rpx;" bindtap="addPoints">+ 批量添加</button>
      </view>

      <view class="manage-modal-actions">
        <button class="btn-sm btn-sm-delete" bindtap="closeModal">取消</button>
        <button class="btn-sm btn-sm-edit" style="background:#ff86a0;color:#fff;" bindtap="saveLesson">保存</button>
      </view>
    </view>
  </view>

  <bottom-nav active="lessons" />
</view>
