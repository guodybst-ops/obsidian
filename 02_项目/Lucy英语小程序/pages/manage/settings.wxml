<view class="manage-shell">
  <view class="manage-header">
    <view class="manage-top" style="height: 88rpx;">
      <view class="manage-top-title">积分配置</view>
    </view>
  </view>

  <view class="manage-body">
    <!-- 任务配置 -->
    <view class="config-section">
      <view class="config-section-title">每日任务</view>
      <block wx:for="{{tasks}}" wx:key="id">
        <view class="config-item">
          <view class="config-item-row">
            <text class="config-item-name">{{item.title}}</text>
            <text class="config-item-points">+{{item.points}} 积分</text>
          </view>
          <view class="config-btn-row">
            <button class="btn-sm btn-sm-edit" data-id="{{item.id}}" bindtap="openTaskEdit">编辑</button>
            <button class="btn-sm btn-sm-delete" data-id="{{item.id}}" bindtap="deleteTask">删除</button>
          </view>
        </view>
      </block>
      <button class="btn-sm-add" bindtap="openTaskAdd">+ 添加任务</button>
    </view>

    <!-- 奖品配置 -->
    <view class="config-section">
      <view class="config-section-title">奖品库</view>
      <block wx:for="{{prizes}}" wx:key="id">
        <view class="config-item">
          <view class="config-item-row">
            <text class="config-item-name">{{item.name}}</text>
            <text class="config-item-points">{{item.points}} 积分</text>
          </view>
          <view class="config-btn-row">
            <button class="btn-sm btn-sm-edit" data-id="{{item.id}}" bindtap="openPrizeEdit">编辑</button>
            <button class="btn-sm btn-sm-delete" data-id="{{item.id}}" bindtap="deletePrize">删除</button>
          </view>
        </view>
      </block>
      <button class="btn-sm-add" bindtap="openPrizeAdd">+ 添加奖品</button>
    </view>
  </view>

  <!-- 任务弹窗 -->
  <view wx:if="{{showTaskModal}}" class="manage-modal-mask" catchtap="closeTaskModal">
    <view class="manage-modal" catchtap="noop">
      <view class="manage-modal-title">{{editTaskId ? '编辑任务' : '添加任务'}}</view>
      <view class="manage-field">
        <view class="manage-field-label">任务名称</view>
        <input class="manage-field-input" value="{{editTaskTitle}}" placeholder="任务名称" bindinput="updateTaskTitle" />
      </view>
      <view class="manage-field">
        <view class="manage-field-label">积分值</view>
        <input class="manage-field-input" value="{{editTaskPoints}}" placeholder="积分值" type="digit" bindinput="updateTaskPoints" />
      </view>
      <view class="manage-modal-actions">
        <button class="btn-sm btn-sm-delete" bindtap="closeTaskModal">取消</button>
        <button class="btn-sm btn-sm-edit" style="background:#ff86a0;color:#fff;" bindtap="saveTask">保存</button>
      </view>
    </view>
  </view>

  <!-- 奖品弹窗 -->
  <view wx:if="{{showPrizeModal}}" class="manage-modal-mask" catchtap="closePrizeModal">
    <view class="manage-modal" catchtap="noop">
      <view class="manage-modal-title">{{editPrizeId ? '编辑奖品' : '添加奖品'}}</view>
      <view class="manage-field">
        <view class="manage-field-label">奖品名称</view>
        <input class="manage-field-input" value="{{editPrizeName}}" placeholder="奖品名称" bindinput="updatePrizeName" />
      </view>
      <view class="manage-field">
        <view class="manage-field-label">所需积分</view>
        <input class="manage-field-input" value="{{editPrizePoints}}" placeholder="所需积分" type="digit" bindinput="updatePrizePoints" />
      </view>
      <view class="manage-field">
        <view class="manage-field-label">奖品图片</view>
        <button class="btn-sm btn-sm-edit" style="width:100%;margin-bottom:8rpx;" bindtap="choosePrizeImage">选择图片</button>
        <image wx:if="{{editPrizeImage}}" src="{{editPrizeImage}}" mode="aspectFill" style="width:100%;height:200rpx;border-radius:16rpx;margin-top:8rpx;" />
      </view>
      <view class="manage-modal-actions">
        <button class="btn-sm btn-sm-delete" bindtap="closePrizeModal">取消</button>
        <button class="btn-sm btn-sm-edit" style="background:#ff86a0;color:#fff;" bindtap="savePrize">保存</button>
      </view>
    </view>
  </view>

  <bottom-nav active="settings" />
</view>
