<view class="page-shell settings-page">
  <view class="top-bar">
    <view class="top-back" bindtap="goBack">‹ 返回</view>
    <view class="top-bar-title">个人设置</view>
    <view class="top-save" bindtap="saveProfile">保存</view>
  </view>

  <view class="settings-content">
    <!-- 头像 -->
    <view class="settings-section" bindtap="chooseAvatar">
      <view class="settings-label">头像</view>
      <view class="avatar-preview-wrap">
        <image
          wx:if="{{avatar}}"
          class="avatar-preview"
          src="{{avatar}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar-preview-placeholder">📷</view>
        <view class="avatar-edit-tip">点击更换</view>
      </view>
    </view>

    <!-- 账号（只读） -->
    <view class="settings-section">
      <view class="settings-label">账号</view>
      <view class="settings-value-readonly">{{account}}</view>
      <view class="settings-hint">账号为唯一标识，不可修改</view>
    </view>

    <!-- 用户名 -->
    <view class="settings-section">
      <view class="settings-label">用户名</view>
      <input
        class="settings-input"
        value="{{displayName}}"
        placeholder="请输入用户名"
        bindinput="updateDisplayName"
      />
    </view>

    <!-- 修改密码 -->
    <view class="settings-section settings-password-section">
      <view class="settings-subtitle">修改密码</view>

      <view class="settings-field">
        <view class="settings-label">旧密码</view>
        <input
          class="settings-input"
          password
          value="{{oldPassword}}"
          placeholder="请输入旧密码"
          bindinput="updateOldPassword"
        />
      </view>

      <view class="settings-field">
        <view class="settings-label">新密码</view>
        <input
          class="settings-input"
          password
          value="{{newPassword}}"
          placeholder="请输入新密码（至少4位）"
          bindinput="updateNewPassword"
        />
      </view>

      <view class="settings-field">
        <view class="settings-label">确认密码</view>
        <input
          class="settings-input"
          password
          value="{{confirmPassword}}"
          placeholder="请再次输入新密码"
          bindinput="updateConfirmPassword"
        />
      </view>
    </view>
  </view>
</view>
