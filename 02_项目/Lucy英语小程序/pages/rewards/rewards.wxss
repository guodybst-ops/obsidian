.rewards-page {
  background: #f4eaec;
}

.avatar-area {
  position: relative;
  height: 258rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 188rpx;
  height: 188rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #fff;
  color: #111;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 12rpx 14rpx 18rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
}

.points-pill {
  position: absolute;
  right: 28rpx;
  bottom: 18rpx;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  background: #202020;
  color: #ff94ab;
  font-size: 24rpx;
  font-weight: 900;
}

.stack-zone {
  position: relative;
  height: 920rpx;
  margin: 40rpx 50rpx 0;
}

.stack-card {
  position: absolute;
  left: 0;
  right: 0;
  min-height: 880rpx;
  border-radius: 26rpx;
  transform-origin: center top;
  box-shadow: 12rpx 16rpx 18rpx rgba(0, 0, 0, 0.22);
  transition: transform 0.25s ease, top 0.25s ease, z-index 0.25s ease;
  box-sizing: border-box;
}

.stack-card.front {
  top: 0;
  z-index: 3;
}

.stack-card.back {
  top: 20rpx;
  z-index: 1;
}

.task-panel {
  padding: 34rpx 34rpx 46rpx;
  background: #fff;
  transform: rotate(-2deg);
}

.task-panel.back {
  transform: translateX(36rpx) rotate(2deg);
}

.prize-panel {
  padding: 34rpx 26rpx 36rpx;
  background: #ffa0b6;
  transform: rotate(0deg);
}

.prize-panel.back {
  transform: translateX(38rpx) rotate(0deg);
}

.panel-heading {
  margin-bottom: 24rpx;
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
  text-align: center;
}

.task-title {
  color: #111;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.task-item {
  min-height: 96rpx;
  padding: 0 26rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 33rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.task-item.black {
  background: #202020;
  color: #ff94ab;
}

.task-item.pink {
  background: #ff86a0;
  color: #111;
}

.task-item.done {
  opacity: 0.55;
}

.prize-scroll {
  height: 740rpx;
}

.prize-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
  padding-bottom: 20rpx;
}

.prize-item {
  min-height: 340rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.prize-item.dark {
  background: #202020;
  color: #fff;
}

.prize-item.light {
  background: #fff;
  color: #111;
}

.prize-item image {
  width: 100%;
  height: 256rpx;
  border-radius: 6rpx;
  background: #f6f6f6;
}

.prize-info {
  min-height: 56rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.prize-info text:first-child {
  max-width: 128rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.show-prizes .task-panel.back {
  top: 24rpx;
}

.show-tasks .prize-panel.back {
  top: 20rpx;
}
