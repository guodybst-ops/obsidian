<view class="page-shell rewards-page">
  <view class="top-bar" style="padding-top: {{navMetrics.top}}px; height: {{navMetrics.height}}px;">
    <view class="top-bar-title">Lucy的雷霆英语王国</view>
  </view>

  <view class="avatar-area">
    <view class="avatar" bindtap="chooseAvatar">
      <image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill"></image>
      <text wx:else>头像</text>
    </view>
    <view class="points-pill">积分余额：{{points}}</view>
  </view>

  <view
    class="stack-zone {{mode === 'prizes' ? 'show-prizes' : 'show-tasks'}}"
    bindtouchstart="handleTouchStart"
    bindtouchend="handleTouchEnd"
  >
    <view class="stack-card prize-panel {{mode === 'prizes' ? 'front' : 'back'}}">
      <view class="panel-heading">积分兑换库</view>
      <scroll-view class="prize-scroll" scroll-y>
        <view class="prize-grid">
          <view
            wx:for="{{prizes}}"
            wx:key="id"
            class="prize-item {{index % 2 === 0 ? 'dark' : 'light'}}"
            data-points="{{item.points}}"
            data-name="{{item.name}}"
            catchtap="redeemPrize"
          >
            <image src="{{item.image}}" mode="aspectFill"></image>
            <view class="prize-info">
              <text>{{item.name}}</text>
              <text>{{item.points}}积分</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="stack-card task-panel {{mode === 'tasks' ? 'front' : 'back'}}">
      <view class="panel-heading task-title">今日任务</view>
      <view class="task-list">
        <view
          wx:for="{{tasks}}"
          wx:key="id"
          class="task-item {{index % 2 === 0 ? 'black' : 'pink'}} {{completedTasks[item.id] ? 'done' : ''}}"
          data-id="{{item.id}}"
          data-points="{{item.points}}"
          catchtap="completeTask"
        >
          <text>{{item.title}}</text>
          <text wx:if="{{completedTasks[item.id]}}">已完成</text>
          <text wx:else>+{{item.points}}</text>
        </view>
      </view>
    </view>
  </view>

  <bottom-nav active="rewards" />
</view>
