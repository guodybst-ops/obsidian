.calendar-page {
  padding: 0 28rpx;
  background: #f5ecee;
}

.calendar-page .top-bar {
  margin-left: -28rpx;
  margin-right: -28rpx;
}

.today-card {
  margin-top: 36rpx;
  min-height: 150rpx;
  padding: 30rpx 28rpx;
  border-radius: 26rpx;
  display: grid;
  grid-template-columns: 1fr 2rpx 1fr;
  align-items: center;
  background: #fff;
  box-sizing: border-box;
}

.today-stat {
  text-align: center;
}

.number {
  color: #000;
  font-size: 70rpx;
  font-weight: 900;
  line-height: 1;
}

.unit {
  margin-left: 8rpx;
  color: #000;
  font-size: 30rpx;
  font-weight: 800;
}

.label {
  margin-top: 6rpx;
  color: #aaa;
  font-size: 22rpx;
  font-weight: 800;
}

.divider {
  width: 2rpx;
  height: 90rpx;
  background: #d7d7d7;
}

.month-card {
  margin-top: 32rpx;
  padding: 32rpx 22rpx;
  border-radius: 26rpx;
  display: grid;
  grid-template-columns: 52rpx 1fr 220rpx;
  gap: 18rpx;
  align-items: center;
  background: #fff;
  box-sizing: border-box;
}

.side-label {
  height: 100%;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: #d9d9d9;
  color: #000;
  font-size: 30rpx;
  font-weight: 900;
}

.heatmap-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.month-switch {
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.month-label {
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
  background: #fff0f5;
  color: #ff86a0;
  font-size: 25rpx;
  font-weight: 800;
}

.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(7, 30rpx);
  grid-auto-rows: 30rpx;
  gap: 10rpx;
  justify-content: center;
  margin-top: 12rpx;
}

.heat-cell {
  width: 30rpx;
  height: 30rpx;
  border-radius: 4rpx;
}

.level-0 { background: #eeeeee; }
.level-empty { background: #eeeeee; opacity: 0.45; }
.level-1 { background: #ffd8d5; }
.level-2 { background: #ffbbb5; }
.level-3 { background: #ff9d93; }
.level-4 { background: #ff6c61; }

.month-stats {
  padding-top: 6rpx;
  text-align: center;
}

.metric {
  height: 58rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  color: #000;
  font-size: 26rpx;
  font-weight: 800;
}

.metric-number {
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.metric-label {
  margin-bottom: 8rpx;
  color: #aaa;
  font-size: 21rpx;
  font-weight: 800;
}

.today-list {
  margin-top: 32rpx;
  padding: 30rpx 30rpx 36rpx;
  border-radius: 24rpx;
  background: #fff;
}

.section-title {
  margin-bottom: 24rpx;
  color: #111;
  font-size: 30rpx;
  font-weight: 900;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  background: #fff1f4;
  color: #ff7794;
  font-size: 23rpx;
  font-weight: 800;
}

.empty-note {
  color: #aaa;
  font-size: 25rpx;
}

.reserved-area {
  min-height: 360rpx;
}

.picker-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.4);
}

.picker-panel {
  width: 580rpx;
  padding: 34rpx 36rpx 40rpx;
  border-radius: 32rpx;
  background: #fff;
  box-sizing: border-box;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  margin-bottom: 34rpx;
}

.picker-year-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  color: #888;
  font-size: 28rpx;
  font-weight: 900;
}

.picker-year {
  color: #111;
  font-size: 36rpx;
  font-weight: 900;
  min-width: 160rpx;
  text-align: center;
}

.picker-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.picker-month {
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f7f7;
  color: #333;
  font-size: 27rpx;
  font-weight: 800;
  transition: background 0.15s ease, color 0.15s ease;
}

.picker-month.current {
  border: 2rpx solid #ff86a0;
  color: #ff86a0;
}

.picker-month.selected {
  background: #ff86a0;
  color: #fff;
  border: none;
}
