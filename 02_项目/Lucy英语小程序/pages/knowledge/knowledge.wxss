.knowledge-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f7eef0;
}

.knowledge-fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  background: #202020;
}

.search-row {
  padding: 18rpx 24rpx 18rpx;
  display: grid;
  grid-template-columns: minmax(150rpx, 29%) minmax(0, 1fr);
  gap: 12rpx;
  align-items: center;
  background: #202020;
}

.search-row picker {
  min-width: 0;
}

.level-pill,
.search-box {
  height: 64rpx;
  border-radius: 32rpx;
  background: #fff;
  box-sizing: border-box;
}

.level-pill {
  width: 100%;
  min-width: 0;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #171717;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
}

.chevron {
  flex: 0 0 auto;
  margin-left: 4rpx;
  color: #aaa;
  font-size: 22rpx;
}

.search-box {
  position: relative;
  padding: 0 54rpx 0 28rpx;
  display: flex;
  align-items: center;
}

.search-box input {
  min-width: 0;
  width: 100%;
  height: 64rpx;
  color: #333;
  font-size: 26rpx;
}

@media (max-width: 360px) {
  .search-row {
    grid-template-columns: minmax(132rpx, 31%) minmax(0, 1fr);
    gap: 10rpx;
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .level-pill {
    padding: 0 10rpx;
    font-size: 22rpx;
  }
}

.search-box input::placeholder {
  color: #b6b6b6;
}

.clear {
  position: absolute;
  right: 22rpx;
  top: 10rpx;
  color: #aaa;
  font-size: 36rpx;
  line-height: 40rpx;
}

.detail-hero {
  padding-top: 0;
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
  background: #262626;
  color: #fff;
  overflow: hidden;
}

.detail-nav {
  position: relative;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.nav-spacer {
  display: none;
}

.back-button {
  position: absolute;
  top: 0;
  left: 16rpx;
  transform: translateY(-50%);
  width: 64rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  box-sizing: border-box;
}

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
}

.detail-title-wrap {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 560rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.detail-lesson-title {
  max-width: 560rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.detail-lesson-level {
  position: absolute;
  top: calc(100% + 6rpx);
  left: 50%;
  transform: translateX(-50%);
  color: #ff86a0;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}

.add-point-wrap {
  padding: 38rpx 0 20rpx;
  display: flex;
  justify-content: center;
  background: #f2e6e8;
}

.add-point-button {
  width: 330rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff86a0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}

.lesson-browser {
  position: relative;
  flex: 1;
  min-height: 0;
}

.browser-scroll {
  width: 100%;
  background: linear-gradient(90deg, rgba(255, 136, 160, 0.26), rgba(255, 255, 255, 0.88) 28%, rgba(255, 255, 255, 0.88) 70%, rgba(255, 136, 160, 0.2));
}

.scroll-inner {
  position: relative;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.scroll-inner::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-image: linear-gradient(0deg, rgba(255,255,255,0.48) 1px, transparent 1px), linear-gradient(90deg, rgba(255,144,166,0.18) 1px, transparent 1px);
  background-size: 24rpx 24rpx;
}

.photo-wall {
  position: relative;
  z-index: 1;
  height: 438rpx;
  overflow: hidden;
  background: #2200bd;
  transition: opacity 0.12s linear;
}

.photo-wall-image {
  width: 100%;
  height: 100%;
}

.photo-wall-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 112rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.change-photo-button {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  z-index: 2;
  height: 54rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #111;
  font-size: 24rpx;
  font-weight: 900;
}

.lesson-grid-wrap {
  position: relative;
  z-index: 2;
  margin-top: -38rpx;
  padding: 0 34rpx 36rpx;
  box-sizing: border-box;
}

.gallery-grid {
  position: relative;
  min-height: 674rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 34rpx 28rpx;
  align-content: start;
}

.photo-card {
  width: 100%;
  height: 202rpx;
  padding: 18rpx 14rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #ff86a0;
  box-shadow: 14rpx 18rpx 20rpx rgba(40, 40, 40, 0.24);
  box-sizing: border-box;
}

.photo-card.selected {
  background: #ff86a0;
  color: #fff;
}

.lesson-card-title {
  width: 100%;
  text-align: center;
  color: inherit;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.add-lesson-card {
  width: 100%;
  height: 202rpx;
  padding: 18rpx 14rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff86a0;
  box-shadow: 14rpx 18rpx 20rpx rgba(40, 40, 40, 0.24);
  box-sizing: border-box;
}

.add-lesson-icon {
  color: #fff;
  font-size: 80rpx;
  font-weight: 300;
  line-height: 1;
}

.lesson-stack {
  position: relative;
  z-index: 3;
  margin-top: 0;
  padding: 0 34rpx 36rpx;
  background: #f2e6e8;
}

.lesson-card {
  padding: 0;
  border-radius: 0;
  background: #f2e6e8;
  box-sizing: border-box;
}

.point-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.point-item {
  overflow: hidden;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 10rpx 18rpx rgba(64, 47, 52, 0.06);
}

.point-main {
  min-height: 84rpx;
  padding: 12rpx 24rpx 12rpx 18rpx;
  display: grid;
  grid-template-columns: 62rpx minmax(0, 1fr) 52rpx;
  gap: 14rpx;
  align-items: center;
  box-sizing: border-box;
}

.point-label {
  height: 30rpx;
  border-radius: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f5;
  color: #ff86a0;
  font-size: 19rpx;
  font-weight: 800;
  white-space: nowrap;
}

.point-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #4a4a4a;
  font-size: 28rpx;
  font-weight: 900;
}

.play-button {
  width: 52rpx;
  height: 52rpx;
  min-width: 52rpx;
  min-height: 52rpx;
  border-radius: 50%;
  padding: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff86a0;
  box-shadow: 0 4rpx 10rpx rgba(255, 134, 160, 0.35);
  transition: transform 0.12s ease, background 0.12s ease;
  box-sizing: border-box;
}

.play-button.playing {
  background: #ff5c85;
  transform: scale(0.94);
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 4rpx;
  flex-shrink: 0;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  border-left: 14rpx solid #fff;
}

.point-detail {
  margin: 0 28rpx;
  padding: 24rpx 0 28rpx;
  border-top: 1rpx solid #eeeeee;
  color: #5f6368;
  font-size: 25rpx;
  line-height: 1.75;
}

.detail-row {
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  gap: 10rpx;
  margin-top: 10rpx;
}

.detail-row text:first-child {
  color: #8b8f96;
  font-weight: 800;
}

.sentence-row {
  align-items: start;
}


.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.38);
}

.teacher-panel,
.lesson-panel {
  width: 100%;
  max-height: 82vh;
  padding: 34rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.panel-title {
  margin-bottom: 22rpx;
  color: #111;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
}

.panel-input,
.panel-textarea {
  width: 100%;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: #f7eef0;
  color: #222;
  font-size: 27rpx;
  box-sizing: border-box;
}

.panel-input {
  height: 76rpx;
  padding: 0 24rpx;
}

.panel-textarea {
  height: 180rpx;
  padding: 22rpx 24rpx;
}

.lesson-name-input {
  height: 120rpx;
}

.lesson-points-input {
  height: 220rpx;
}

.panel-input::placeholder,
.panel-textarea::placeholder {
  color: #b6b6b6;
}

.panel-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.ghost,
.primary,
.use-button {
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.ghost {
  background: #f3f3f3;
  color: #777;
}

.primary,
.use-button {
  background: #ff86a0;
  color: #fff;
}

.preview-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f7eef0;
}

.preview-title {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.preview-item {
  margin-top: 10rpx;
  color: #555;
  font-size: 24rpx;
  line-height: 1.45;
}

.use-button {
  margin-top: 18rpx;
}
