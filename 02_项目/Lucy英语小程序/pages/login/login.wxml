<view class="page-shell login-page">
  <view class="top-bar">
    <view class="top-bar-title">Lucy的雷霆英语王国</view>
  </view>

  <!-- 未登录：登录表单 -->
  <view wx:if="{{!isLoggedIn}}" class="login-content">
    <view class="login-card">
      <view class="login-title">登录</view>
      <view class="login-subtitle">请选择身份并登录</view>

      <view class="role-switch">
        <view class="role-option {{selectedRole === 'student' ? 'active' : ''}}" data-role="student" bindtap="switchRole">
          <text class="role-icon">👧</text>
          <text class="role-name">Lucy</text>
        </view>
        <view class="role-option {{selectedRole === 'teacher' ? 'active' : ''}}" data-role="teacher" bindtap="switchRole">
          <text class="role-icon">👩‍🏫</text>
          <text class="role-name">老师 / Lucy妈妈</text>
        </view>
      </view>

      <view class="login-form">
        <input
          class="login-input"
          value="{{account}}"
          placeholder="请输入账号"
          bindinput="updateAccount"
        />
        <input
          class="login-input"
          password
          value="{{password}}"
          placeholder="请输入密码"
          bindinput="updatePassword"
          bindconfirm="doLogin"
        />
        <button class="login-button" bindtap="doLogin">登 录</button>
      </view>
    </view>
  </view>

  <!-- 已登录：用户信息页 -->
  <view wx:if="{{isLoggedIn}}" class="profile-content">
    <view class="profile-card">
      <view class="profile-avatar-wrap" bindtap="goSettings">
        <image
          wx:if="{{currentUser.avatar}}"
          class="profile-avatar"
          src="{{currentUser.avatar}}"
          mode="aspectFill"
        />
        <view wx:else class="profile-avatar-placeholder">{{currentUser.role === 'teacher' ? '👩‍🏫' : '👧'}}</view>
      </view>

      <view class="profile-name">{{currentUser.displayName || currentUser.account}}</view>
      <view class="profile-account">账号：{{currentUser.account}}</view>
      <view class="profile-role-tag">{{currentUser.role === 'teacher' ? '老师/家长' : '学生'}}</view>

      <view class="profile-menu">
        <view class="profile-menu-item" bindtap="goSettings">
          <text class="menu-icon">⚙️</text>
          <text class="menu-label">设置</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="profile-menu-item profile-menu-logout" bindtap="doLogout">
          <text class="menu-icon">🚪</text>
          <text class="menu-label">退出登录</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <bottom-nav active="login" />
</view>
