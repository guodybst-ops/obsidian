# OpenAI-compatible text generation
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_TEXT_API=auto
OPENAI_REASONING_EFFORT=
OPENAI_MAX_TOKENS=7000

# Image generation. Set AI_IMAGE_MODE=image to call the image API.
AI_IMAGE_MODE=prompt
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low

# Obsidian output. Leave blank to use the current Vault root automatically.
OBSIDIAN_VAULT_ROOT=

# WeChat Official Account draft publishing.
# Keep disabled until AppID/AppSecret/IP whitelist/media permissions are confirmed.
WECHAT_DRAFT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
